{
  "name": "munim-merchant-growth-ai",
  "version": "1.0.0",
  "description": "Munim — Voice-First AI Merchant Business Assistant (Paytm Build for India Hackathon)",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "start": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "backend": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "smoke-test": "python scripts/smoke_test.py",
    "test:backend": "python -m pytest backend/tests -v"
  },
  "dependencies": {},
  "devDependencies": {}
}
