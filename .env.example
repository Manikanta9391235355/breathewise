# Server Host & Port
PORT=8000
HOST=0.0.0.0

# Database Persistence
# Default: Local SQLite database
DATABASE_URL=sqlite:///./munim.db
# Production Supabase PostgreSQL alternative:
# DATABASE_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Cryptographic Secret Key
SECRET_KEY=munim-paytm-hackathon-2026-secret-key-replace-in-production

# AI Provider: Sarvam AI Credentials (provisioned for speech & intelligence)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3

# Business Demo Configuration
DEMO_BUSINESS_DATE=2026-11-13
TIMEZONE=Asia/Kolkata
DEFAULT_MERCHANT_ID=M01
